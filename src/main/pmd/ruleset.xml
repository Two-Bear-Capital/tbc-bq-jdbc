<?xml version="1.0"?>
<ruleset name="TBC BQ JDBC Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.net/ruleset_2_0_0.xsd">

    <description>
        Custom PMD ruleset for tbc-bq-jdbc. Inherits Best Practices and Error Prone rulesets
        with targeted exclusions for JDBC API constraints and BigQuery SDK limitations.
    </description>

    <!-- =========================================================================
         Best Practices
         ========================================================================= -->
    <rule ref="category/java/bestpractices.xml">

        <!--
            UseVarargs: changing String[] last-parameter to varargs is a binary-incompatible
            API change for any downstream caller. Not worth the risk for internal helpers.
        -->
        <exclude name="UseVarargs"/>

        <!--
            GuardLogStatement: the project uses SLF4J 2.x parameterized logging throughout
            (e.g. logger.debug("msg {}", var)), which defers string formatting automatically.
            Only trace-level calls need explicit guards; debug/info/warn/error are excluded.
            Configure at rule level below so trace guards remain enforced.
        -->
        <exclude name="GuardLogStatement"/>

        <!--
            LooseCoupling: BigQuery Java SDK exposes FieldList, FieldValueList, etc. as
            concrete classes without stable public interfaces, making it impossible to
            program to an interface here.
        -->
        <exclude name="LooseCoupling"/>

        <!--
            AvoidReassigningLoopVariables: re-included below configured to allow the
            skip-ahead form, which the escape decoder in SqlStringLiterals depends on.
        -->
        <exclude name="AvoidReassigningLoopVariables"/>

    </rule>

    <!--
        Re-include AvoidReassigningLoopVariables allowing a loop to skip iterations.
        SqlStringLiterals scans a string one character at a time and consumes the
        character after a backslash with charAt(++i); advancing the cursor past the
        escape IS the algorithm, and rewriting it as a while loop only moves the same
        mutation somewhere less obvious.
    -->
    <rule ref="category/java/bestpractices.xml/AvoidReassigningLoopVariables">
        <properties>
            <property name="forReassign" value="skip"/>
        </properties>
    </rule>

    <!-- Re-include GuardLogStatement scoped to trace level only -->
    <rule ref="category/java/bestpractices.xml/GuardLogStatement">
        <properties>
            <property name="logLevels" value="trace"/>
            <property name="guardsMethods" value="isTraceEnabled"/>
        </properties>
    </rule>

    <!-- =========================================================================
         Error Prone
         ========================================================================= -->
    <rule ref="category/java/errorprone.xml">

        <!--
            ReplaceJavaUtilDate: java.sql.Date, java.sql.Time, and java.sql.Timestamp all
            extend java.util.Date. The JDBC 4.x PreparedStatement and ResultSet method
            signatures (setDate, getDate, setTime, getTime, setTimestamp, getTimestamp)
            require java.util.Date/Calendar. These cannot be changed.
        -->
        <exclude name="ReplaceJavaUtilDate"/>

        <!--
            ReplaceJavaUtilCalendar: same JDBC API constraint — setDate(Date x, Calendar cal)
            and getDate(int col, Calendar cal) etc. require java.util.Calendar.
        -->
        <exclude name="ReplaceJavaUtilCalendar"/>

        <!--
            AvoidDuplicateLiterals: repeated string literals in JDBC metadata column-name
            arrays ("TABLE_CAT", "TABLE_SCHEM", etc.), property-info builders ("true"/"false"),
            and version-parsing code. Extracting each to a named constant adds boilerplate
            with no practical benefit in these contexts.
        -->
        <exclude name="AvoidDuplicateLiterals"/>

        <!--
            AvoidLiteralsInIfCondition: numeric/string literals in parsing and validation
            conditionals (e.g. parts.length == 3, idx < 1, "true"/"false" comparisons).
            These are intentional, self-documenting, and extracting them to constants would
            add noise without improving readability.
        -->
        <exclude name="AvoidLiteralsInIfCondition"/>

        <!--
            AssignmentInOperand: re-included below allowing increment and decrement,
            which is the only form this codebase uses.
        -->
        <exclude name="AssignmentInOperand"/>

        <!--
            CloseResource: re-included below with the borrowed types allowed.
        -->
        <exclude name="CloseResource"/>

    </rule>

    <!--
        Re-include AssignmentInOperand permitting increment and decrement. Every hit was
        a post-increment reading and advancing a cursor in the same expression
        (ordinal++ while numbering columns, rowInBatch++ while walking an Arrow batch),
        which is idiomatic rather than the hidden side effect the rule is aimed at.
        Assignment proper in an operand stays reported.
    -->
    <rule ref="category/java/errorprone.xml/AssignmentInOperand">
        <properties>
            <property name="allowIncrementDecrement" value="true"/>
        </properties>
    </rule>

    <!--
        Re-include CloseResource with the types this driver borrows rather than owns.
        The rule cannot tell the two apart, and closing any of these would be a bug:

          - Arrow FieldVector/ListVector/StructVector come from VectorSchemaRoot.getVector()
            and ListVector.getDataVector(). They belong to the root, which
            StorageReadResultSet closes once; releasing one per row would free buffers
            still being read.
          - BQConnection is the caller's connection, reached through
            Statement.getConnection(). A ResultSet closing it would close the session
            around it.
          - TableDataWriteChannel is closed deliberately and in order in the batch load
            path, because the load job does not exist until the channel is closed.
    -->
    <rule ref="category/java/errorprone.xml/CloseResource">
        <properties>
            <!--
                Comma-delimited, not pipe-delimited: PMD parses each entry as a Java
                binary name, so a pipe-joined string is one invalid name and the rule
                throws on every file instead of running. That failure looks like a
                clean report, because a rule that errored reports no violations.
            -->
            <property name="allowedResourceTypes"
                      value="java.io.ByteArrayOutputStream,java.io.ByteArrayInputStream,java.io.StringWriter,java.io.CharArrayWriter,java.util.stream.Stream,org.apache.arrow.vector.FieldVector,org.apache.arrow.vector.complex.ListVector,org.apache.arrow.vector.complex.StructVector,vc.tbc.bq.jdbc.BQConnection,com.google.cloud.bigquery.TableDataWriteChannel"/>
        </properties>
    </rule>

</ruleset>
